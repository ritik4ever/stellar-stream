exports[`StreamTimeline snapshots > matches snapshot for error state 1`] = `
<div
  class="activity-error"
  data-testid="timeline-error-state"
  role="alert"
>
  <h3
    data-testid="timeline-error-title"
  >
    Unable to load activity
  </h3>
  <p
    data-testid="timeline-error-message"
  >
    Network error
  </p>
  <div
    style="display: flex; gap: 0.5rem; align-items: center; margin-top: 0.75rem; flex-wrap: wrap;"
  >
    <button
      class="retry-btn"
      data-testid="timeline-retry-btn"
      style="min-height: 44px; min-width: 44px;"
      type="button"
    >
      Try again
    </button>
  </div>
</div>
`;

