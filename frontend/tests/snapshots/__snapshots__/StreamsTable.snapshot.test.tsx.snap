exports[`StreamsTable snapshots > matches snapshot with active and completed streams 1`] = `
<div
  class="card"
>
  <div
    class="filter-bar card"
    style="margin-bottom: 1.5rem; padding: 1.25rem;"
  >
    <div
      class="filter-grid"
      style="display: grid; gap: 1rem; grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));"
