{
  "compilerOptions": {
    "target": "ES2020",
    "module": "commonjs",
    "lib": ["ES2020"],
    "types": ["node"],
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true,
    "moduleResolution": "node",
    "noEmit": true,
    "baseUrl": ".",
    "paths": {
      "better-sqlite3": ["../../backend/node_modules/@types/better-sqlite3"],
      "*": ["../../backend/node_modules/*"]
    }
  },
  "include": ["./**/*.ts"]
}
