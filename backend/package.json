    "express": "^5.2.1",
    "express-rate-limit": "^8.7.0",
    "helmet": "^8.2.0",
    "ioredis": "^6.0.0",
    "jsonwebtoken": "^9.0.2",
    "p-limit": "^7.3.3",
    "pg": "^8.23.0",
    "pino": "^10.3.1",
    "prom-client": "^15.1.3",
    "swagger-ui-express": "^5.0.1",
    "ws": "^8.21.3",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@apidevtools/swagger-parser": "^13.1.0",
    "@eslint/js": "^10.0.1",
    "@types/better-sqlite3": "^9.6.0",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.3",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^26.6.2",
    "@types/pg": "^8.23.1",
    "@types/supertest": "^7.2.1",
    "@types/swagger-ui-express": "^4.1.8",
    "@types/ws": "^8.5.10",
    "@vitest/coverage-v8": "^5.0.1",
    "autocannon": "^8.0.0",
    "supertest": "^7.3.0",
    "ts-node-dev": "^2.0.0",
    "typescript": "^7.0.2",
    "typescript-eslint": "^8.70.1",
    "vite": "^6.4.0",
    "vitest": "^5.0.1"
